# Sunucu
PORT=8000
PUBLIC_URL=https://photoroot.app
NODE_ENV=production
DATABASE_PATH=./data/photoroot.db
# IP adreslerini saklamadan saymak için rastgele uzun bir değer (ör. openssl rand -hex 32)
IP_SALT=
# Sunucu bir proxy/yük dengeleyici arkasındaysa (Render, Fly, Nginx) 1 yap
TRUST_PROXY=1

# Ödeme: iyzico (geliştirmede varsayılan: mock)
PAYMENT_PROVIDER=iyzico
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_MERCHANT_ID=
# Sandbox: https://sandbox-api.iyzipay.com · Canlı: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# node scripts/iyzico-setup.js çıktısından
IYZICO_PLAN_PRO_MONTHLY=
IYZICO_PLAN_PRO_YEARLY=
IYZICO_PLAN_BUSINESS_MONTHLY=
IYZICO_PLAN_BUSINESS_YEARLY=
